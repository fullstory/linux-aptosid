# Avoid dpkg-buildapi reading debian/control at parse time (e.g. after
# maintainerclean removed it); a real Build-Depends declaration still wins.
ifeq ($(wildcard debian/control),)
  DPKG_BUILD_API := 0
endif

include /usr/share/dpkg/default.mk

BUILD_DIR = debian/build
STAMPS_DIR = debian/stamps
DISTRIBUTOR := aptosid

-include debian/rules.defs.local
