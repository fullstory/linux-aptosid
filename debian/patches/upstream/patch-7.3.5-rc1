+	resp->status = nfsacld_map_status(resp->status);
 	return rpc_success;
 
 out_drop_lock:
@@ -163,6 +221,7 @@ static __be32 nfsacld_proc_getattr(struc
 		goto out;
 	resp->status = fh_getattr(&resp->fh, &resp->stat);
 out:
+	resp->status = nfsacld_map_status(resp->status);
 	return rpc_success;
 }
 
@@ -180,11 +239,14 @@ static __be32 nfsacld_proc_access(struct
 
