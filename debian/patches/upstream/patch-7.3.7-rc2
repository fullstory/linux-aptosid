 {
 	struct device *dev = xe->drm.dev;
@@ -284,6 +314,12 @@ int xe_device_sysfs_init(struct xe_devic
 		if (ret)
 			return ret;
 	}
+
+	if (xe->info.has_device_uid) {
+		ret = devm_device_add_group(dev, &device_uid_attr_group);
+		if (ret)
+			return ret;
+	}
 
 	return 0;
 }
