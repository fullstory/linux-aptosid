-		xe_mmio_write32(&gt->mmio,
-				GRAPHICS_VER(xe) >= 20 ? XE2_LMEM_CFG : LMEM_CFG,
-				config);
+	lmtt_setup_dir_ptr_gt(gt, config);
 
-	if (xe_device_has_mert(xe) && xe_tile_is_root(tile))
+	if (xe_device_has_mert(xe) && xe_tile_is_root(tile) &&
