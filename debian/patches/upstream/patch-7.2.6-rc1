+++ b/drivers/net/ethernet/microsoft/mana/gdma_main.c
@@ -180,6 +180,7 @@ static int mana_gd_query_max_resources(s
 	struct gdma_query_max_resources_resp resp = {};
 	struct gdma_general_req req = {};
